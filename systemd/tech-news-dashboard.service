[Unit]
Description=Market Ledger editorial dashboard

[Service]
WorkingDirectory=%h/newspaper_dashboard
EnvironmentFile=-%h/.config/tech-news/pages.env
EnvironmentFile=-%h/.config/tech-news/shared.env
ExecStart=%h/newspaper_dashboard/bin/market-ledger serve
Restart=on-failure

[Install]
WantedBy=default.target
